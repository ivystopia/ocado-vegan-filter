{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "cases",
    "rubric_rationale",
    "require_every_observed_issue_for_correct_unknown"
  ],
  "properties": {
    "cases": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "case_id",
          "target_identity",
          "mismatch_type",
          "minimum_issue_codes",
          "evidence_refs",
          "rationale"
        ],
        "properties": {
          "case_id": {
            "type": "string"
          },
          "target_identity": {
            "type": "string",
            "enum": [
              "established",
              "conflicted",
              "insufficient"
            ]
          },
          "mismatch_type": {
            "type": "string",
            "enum": [
              "target_identity_conflict",
              "inapplicable_candidate",
              "both",
              "none"
            ]
          },
          "minimum_issue_codes": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "identity_conflict",
                "identity_insufficient",
                "evidence_conflict",
                "claim_scope_mismatch",
                "composition_incomplete",
                "source_unresolved",
                "processing_unresolved",
                "evidence_stale",
                "animal_ingredient",
                "animal_processing",
                "explicit_nonvegan",
                "tag_animal_conflict",
                "unsupported_assessment",
                "other_material_uncertainty"
              ]
            }
          },
          "evidence_refs": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "path",
                "quote"
              ],
              "properties": {
                "path": {
                  "type": "string"
                },
                "quote": {
                  "type": "string"
                }
              }
            }
          },
          "rationale": {
            "type": "string"
          }
        }
      }
    },
    "rubric_rationale": {
      "type": "string"
    },
    "require_every_observed_issue_for_correct_unknown": {
      "type": "boolean"
    }
  }
}
